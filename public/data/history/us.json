{"version":1,"entries":[{"id":"period-early-exploration","kind":"period","name":{"bg":"","en":"Early Exploration"},"aliases":[],"role":null,"start":"1492-10-12","end":"1607-05-13","startYear":1492,"endYear":1607,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"European navigators reach the Americas, where Indigenous peoples already live."}},{"id":"period-early-colonies","kind":"period","name":{"bg":"","en":"Early Colonies"},"aliases":[],"role":null,"start":"1607-05-14","end":"1763-02-09","startYear":1607,"endYear":1763,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"European settlements are founded along the eastern coast of North America."}},{"id":"period-revolutionary-era","kind":"period","name":{"bg":"","en":"Revolutionary Era"},"aliases":[],"role":null,"start":"1763-02-10","end":"1783-09-02","startYear":1763,"endYear":1783,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The Thirteen Colonies resist British rule and fight a war of independence."}},{"id":"period-confederation-and-constitution","kind":"period","name":{"bg":"","en":"Confederation and Constitution"},"aliases":[],"role":null,"start":"1783-09-03","end":"1789-04-29","startYear":1783,"endYear":1789,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The new country is governed under the Articles of Confederation and then adopts the Constitution."}},{"id":"period-early-republic","kind":"period","name":{"bg":"","en":"Early Republic"},"aliases":[],"role":null,"start":"1789-04-30","end":"1829-03-03","startYear":1789,"endYear":1829,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The first presidents build the institutions of the federal government."}},{"id":"period-jacksonian-era-and-expansion","kind":"period","name":{"bg":"","en":"Jacksonian Era and Expansion"},"aliases":[],"role":null,"start":"1829-03-04","end":"1861-04-11","startYear":1829,"endYear":1861,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Voting rights widen among white men and the country expands westward."}},{"id":"period-civil-war","kind":"period","name":{"bg":"","en":"Civil War"},"aliases":[],"role":null,"start":"1861-04-12","end":"1865-04-09","startYear":1861,"endYear":1865,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The Northern and Southern states fight each other over secession and slavery."}},{"id":"period-reconstruction","kind":"period","name":{"bg":"","en":"Reconstruction"},"aliases":[],"role":null,"start":"1865-04-10","end":"1877-03-04","startYear":1865,"endYear":1877,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The Southern states are readmitted to the Union and slavery is formally abolished."}},{"id":"period-gilded-age-and-progressive-era","kind":"period","name":{"bg":"","en":"Gilded Age and Progressive Era"},"aliases":[],"role":null,"start":"1877-03-05","end":"1917-04-05","startYear":1877,"endYear":1917,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Rapid industrialisation and immigration, followed by reform movements."}},{"id":"period-world-wars-and-interwar-years","kind":"period","name":{"bg":"","en":"World Wars and Interwar Years"},"aliases":[],"role":null,"start":"1917-04-06","end":"1945-09-02","startYear":1917,"endYear":1945,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The country takes part in two world wars and lives through the Great Depression."}},{"id":"period-cold-war","kind":"period","name":{"bg":"","en":"Cold War"},"aliases":[],"role":null,"start":"1945-09-03","end":"1991-12-26","startYear":1945,"endYear":1991,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The United States competes with the Soviet Union in politics, arms and science."}},{"id":"period-post-cold-war-era","kind":"period","name":{"bg":"","en":"Post-Cold War Era"},"aliases":[],"role":null,"start":"1991-12-27","end":null,"startYear":1991,"endYear":null,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"The United States remains a leading military and economic power after the Soviet collapse."}},{"id":"pres-washington","kind":"ruler","name":{"bg":"","en":"George Washington"},"aliases":["Washington","G. Washington","Вашингтон","Джордж Вашингтон"],"role":"president","start":"1789-04-30","end":"1797-03-03","startYear":1789,"endYear":1797,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Commanded the Continental Army and set many precedents, including stepping down after two terms."}},{"id":"pres-j-adams","kind":"ruler","name":{"bg":"","en":"John Adams"},"aliases":["John Adams Sr","Джон Адамс"],"role":"president","start":"1797-03-04","end":"1801-03-03","startYear":1797,"endYear":1801,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"First president to live in the White House; his term was shaped by the Quasi-War with France and the Alien and Sedition Acts."}},{"id":"pres-jefferson","kind":"ruler","name":{"bg":"","en":"Thomas Jefferson"},"aliases":["Jefferson","T. Jefferson","Джеферсън","Томас Джеферсън"],"role":"president","start":"1801-03-04","end":"1809-03-03","startYear":1801,"endYear":1809,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Author of the Declaration of Independence who doubled the country's size with the Louisiana Purchase (1803)."}},{"id":"pres-madison","kind":"ruler","name":{"bg":"","en":"James Madison"},"aliases":["Madison","J. Madison","Мадисън","Джеймс Мадисън"],"role":"president","start":"1809-03-04","end":"1817-03-03","startYear":1809,"endYear":1817,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Main architect of the Constitution and author of the Bill of Rights; led the country in the War of 1812."}},{"id":"pres-monroe","kind":"ruler","name":{"bg":"","en":"James Monroe"},"aliases":["Monroe","J. Monroe","Монро","Джеймс Монро"],"role":"president","start":"1817-03-04","end":"1825-03-03","startYear":1817,"endYear":1825,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Presided over the \"Era of Good Feelings\" and announced the Monroe Doctrine (1823) against new European colonies in the Americas."}},{"id":"pres-jq-adams","kind":"ruler","name":{"bg":"","en":"John Quincy Adams"},"aliases":["J. Q. Adams","JQA","Adams Jr","Джон Куинси Адамс"],"role":"president","start":"1825-03-04","end":"1829-03-03","startYear":1825,"endYear":1829,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Chosen by the House of Representatives after the 1824 election had no majority winner; son of John Adams."}},{"id":"pres-jackson","kind":"ruler","name":{"bg":"","en":"Andrew Jackson"},"aliases":["Jackson","A. Jackson","Джаксън","Андрю Джаксън"],"role":"president","start":"1829-03-04","end":"1837-03-03","startYear":1829,"endYear":1837,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Expanded presidential power, fought the Second Bank of the United States and signed the Indian Removal Act (1830)."}},{"id":"pres-van-buren","kind":"ruler","name":{"bg":"","en":"Martin Van Buren"},"aliases":["Van Buren","M. Van Buren","Ван Бюрен","Мартин Ван Бюрен"],"role":"president","start":"1837-03-04","end":"1841-03-03","startYear":1837,"endYear":1841,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Presided over the Panic of 1837 and the long depression that followed; first president born a US citizen."}},{"id":"pres-wh-harrison","kind":"ruler","name":{"bg":"","en":"William Henry Harrison"},"aliases":["W. H. Harrison","Old Tippecanoe","Староселски Типекану","Уилям Хенри Харисън"],"role":"president","start":"1841-03-04","end":"1841-04-04","startYear":1841,"endYear":1841,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Died 31 days after taking office, the shortest presidency in US history."}},{"id":"pres-tyler","kind":"ruler","name":{"bg":"","en":"John Tyler"},"aliases":["Tyler","J. Tyler","Тайлър","Джон Тайлър"],"role":"president","elected":false,"start":"1841-04-04","end":"1845-03-03","startYear":1841,"endYear":1845,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"First vice president to take over after a president's death, setting the precedent that he becomes full president; Texas annexation was approved at the end of his term."}},{"id":"pres-polk","kind":"ruler","name":{"bg":"","en":"James K. Polk"},"aliases":["Polk","J. K. Polk","James Polk","Полк","Джеймс К. Полк"],"role":"president","start":"1845-03-04","end":"1849-03-03","startYear":1845,"endYear":1849,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Won the Mexican-American War (1846-48), gaining California and the Southwest, and settled the Oregon border with Britain."}},{"id":"pres-taylor","kind":"ruler","name":{"bg":"","en":"Zachary Taylor"},"aliases":["Taylor","Z. Taylor","Old Rough and Ready","Тейлър","Закъри Тейлър"],"role":"president","start":"1849-03-04","end":"1850-07-09","startYear":1849,"endYear":1850,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"General and hero of the Mexican-American War who died in office during the crisis over slavery in the new territories. His oath was taken on 05.03.1849 because 04.03 was a Sunday."}},{"id":"pres-fillmore","kind":"ruler","name":{"bg":"","en":"Millard Fillmore"},"aliases":["Fillmore","M. Fillmore","Филмор","Милард Филмор"],"role":"president","elected":false,"start":"1850-07-09","end":"1853-03-03","startYear":1850,"endYear":1853,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Signed the Compromise of 1850, including the Fugitive Slave Act."}},{"id":"pres-pierce","kind":"ruler","name":{"bg":"","en":"Franklin Pierce"},"aliases":["Pierce","F. Pierce","Пиърс","Франклин Пиърс"],"role":"president","start":"1853-03-04","end":"1857-03-03","startYear":1853,"endYear":1857,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Signed the Kansas-Nebraska Act (1854), which reopened the fight over slavery in the territories."}},{"id":"pres-buchanan","kind":"ruler","name":{"bg":"","en":"James Buchanan"},"aliases":["Buchanan","J. Buchanan","Бюканън","Джеймс Бюканън"],"role":"president","start":"1857-03-04","end":"1861-03-03","startYear":1857,"endYear":1861,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Failed to stop the secession of Southern states in the months after Lincoln's election."}},{"id":"pres-lincoln","kind":"ruler","name":{"bg":"","en":"Abraham Lincoln"},"aliases":["Lincoln","A. Lincoln","Abe Lincoln","Линкълн","Ейбрахам Линкълн"],"role":"president","start":"1861-03-04","end":"1865-04-15","startYear":1861,"endYear":1865,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Led the Union through the Civil War, issued the Emancipation Proclamation, and was shot by John Wilkes Booth on 14.04.1865."}},{"id":"pres-a-johnson","kind":"ruler","name":{"bg":"","en":"Andrew Johnson"},"aliases":["A. Johnson","Andy Johnson","Андрю Джонсън"],"role":"president","elected":false,"start":"1865-04-15","end":"1869-03-03","startYear":1865,"endYear":1869,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Clashed with Congress over Reconstruction and became the first president impeached (1868), but was acquitted by one vote."}},{"id":"pres-grant","kind":"ruler","name":{"bg":"","en":"Ulysses S. Grant"},"aliases":["Grant","U. S. Grant","Грант","Юлисис С. Грант"],"role":"president","start":"1869-03-04","end":"1877-03-03","startYear":1869,"endYear":1877,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Union general who won the Civil War; as president he enforced Reconstruction against the Ku Klux Klan, but his administration was hit by corruption scandals."}},{"id":"pres-hayes","kind":"ruler","name":{"bg":"","en":"Rutherford B. Hayes"},"aliases":["Hayes","R. B. Hayes","Хейс","Ръдърфорд Б. Хейс"],"role":"president","start":"1877-03-04","end":"1881-03-03","startYear":1877,"endYear":1881,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Won the disputed 1876 election by one electoral vote; the Compromise of 1877 ended Reconstruction. His public oath was on 05.03.1877 because 04.03 was a Sunday."}},{"id":"pres-garfield","kind":"ruler","name":{"bg":"","en":"James A. Garfield"},"aliases":["Garfield","J. A. Garfield","Гарфийлд","Джеймс А. Гарфийлд"],"role":"president","start":"1881-03-04","end":"1881-09-19","startYear":1881,"endYear":1881,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Shot by Charles Guiteau on 02.07.1881 and died 11 weeks later."}},{"id":"pres-arthur","kind":"ruler","name":{"bg":"","en":"Chester A. Arthur"},"aliases":["Arthur","C. A. Arthur","Артър","Честър А. Артър"],"role":"president","elected":false,"start":"1881-09-19","end":"1885-03-03","startYear":1881,"endYear":1885,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Signed the Pendleton Civil Service Reform Act (1883), which began to end the spoils system."}},{"id":"pres-cleveland-1","kind":"ruler","name":{"bg":"","en":"Grover Cleveland"},"aliases":["Cleveland","G. Cleveland","Кливланд","Гроувър Кливланд"],"role":"president","start":"1885-03-04","end":"1889-03-03","startYear":1885,"endYear":1889,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"First Democrat elected after the Civil War; known for honesty in office and many vetoes. Served two non-consecutive terms (22nd and 24th president)."}},{"id":"pres-b-harrison","kind":"ruler","name":{"bg":"","en":"Benjamin Harrison"},"aliases":["B. Harrison","Ben Harrison","Бенджамин Харисън"],"role":"president","start":"1889-03-04","end":"1893-03-03","startYear":1889,"endYear":1893,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Grandson of William Henry Harrison; signed the Sherman Antitrust Act (1890)."}},{"id":"pres-cleveland-2","kind":"ruler","name":{"bg":"","en":"Grover Cleveland"},"aliases":["Cleveland","G. Cleveland","Кливланд","Гроувър Кливланд"],"role":"president","start":"1893-03-04","end":"1897-03-03","startYear":1893,"endYear":1897,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Returned after losing the 1888 election; faced the Panic of 1893 and the Pullman Strike."}},{"id":"pres-mckinley","kind":"ruler","name":{"bg":"","en":"William McKinley"},"aliases":["McKinley","W. McKinley","Маккинли","Уилям Маккинли"],"role":"president","start":"1897-03-04","end":"1901-09-14","startYear":1897,"endYear":1901,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Led the country in the Spanish-American War (1898), gaining Puerto Rico, Guam and the Philippines; shot in Buffalo on 06.09.1901."}},{"id":"pres-t-roosevelt","kind":"ruler","name":{"bg":"","en":"Theodore Roosevelt"},"aliases":["T. Roosevelt","Teddy Roosevelt","TR","Теди Рузвелт","Теодор Рузвелт"],"role":"president","start":"1901-09-14","end":"1909-03-03","startYear":1901,"endYear":1909,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Youngest person to hold the office (42); known for trust-busting, conservation and the Panama Canal; won the Nobel Peace Prize in 1906. Won his own term in 1904."}},{"id":"pres-taft","kind":"ruler","name":{"bg":"","en":"William Howard Taft"},"aliases":["Taft","W. H. Taft","Тафт","Уилям Хауърд Тафт"],"role":"president","start":"1909-03-04","end":"1913-03-03","startYear":1909,"endYear":1913,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Only person to be both president and Chief Justice of the United States (1921-1930)."}},{"id":"pres-wilson","kind":"ruler","name":{"bg":"","en":"Woodrow Wilson"},"aliases":["Wilson","W. Wilson","Уилсън","Удроу Уилсън"],"role":"president","start":"1913-03-04","end":"1921-03-03","startYear":1913,"endYear":1921,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Took the US into World War I in 1917 and proposed the League of Nations, which the Senate refused to join."}},{"id":"pres-harding","kind":"ruler","name":{"bg":"","en":"Warren G. Harding"},"aliases":["Harding","W. G. Harding","Хардинг","Уорън Г. Хардинг"],"role":"president","start":"1921-03-04","end":"1923-08-02","startYear":1921,"endYear":1923,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Died in office; scandals such as Teapot Dome came to light after his death."}},{"id":"pres-coolidge","kind":"ruler","name":{"bg":"","en":"Calvin Coolidge"},"aliases":["Coolidge","C. Coolidge","Кулидж","Калвин Кулидж"],"role":"president","start":"1923-08-02","end":"1929-03-03","startYear":1923,"endYear":1929,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Presided over the prosperity of the 1920s with a quiet, small-government style. Won his own term in 1924."}},{"id":"pres-hoover","kind":"ruler","name":{"bg":"","en":"Herbert Hoover"},"aliases":["Hoover","H. Hoover","Хувър","Хърбърт Хувър"],"role":"president","start":"1929-03-04","end":"1933-03-03","startYear":1929,"endYear":1933,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"President when the stock market crashed in 1929 and the Great Depression began."}},{"id":"pres-f-roosevelt","kind":"ruler","name":{"bg":"","en":"Franklin D. Roosevelt"},"aliases":["F. D. Roosevelt","FDR","Franklin Roosevelt","Франклин Д. Рузвелт","Ф. Д. Рузвелт","ФДР","Франклин Рузвелт"],"role":"president","start":"1933-03-04","end":"1945-04-12","startYear":1933,"endYear":1945,"precision":"exact","style":"new","tier":1,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Only president elected four times; led the New Deal and most of World War II, and died in office."}},{"id":"pres-truman","kind":"ruler","name":{"bg":"","en":"Harry S. Truman"},"aliases":["Truman","H. S. Truman","Труман","Хари С. Труман"],"role":"president","start":"1945-04-12","end":"1953-01-19","startYear":1945,"endYear":1953,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Ordered the atomic bombings of Japan, launched the Marshall Plan and the Truman Doctrine, and led the US into the Korean War. Won his own term in 1948."}},{"id":"pres-eisenhower","kind":"ruler","name":{"bg":"","en":"Dwight D. Eisenhower"},"aliases":["Eisenhower","Ike","D. D. Eisenhower","Айзенхауер","Айк","Дуайт Айзенхауер"],"role":"president","start":"1953-01-20","end":"1961-01-19","startYear":1953,"endYear":1961,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"WWII supreme commander in Europe who ended the Korean War and built the Interstate Highway System."}},{"id":"pres-kennedy","kind":"ruler","name":{"bg":"","en":"John F. Kennedy"},"aliases":["Kennedy","JFK","J. F. Kennedy","Кенеди","Джон Ф. Кенеди"],"role":"president","start":"1961-01-20","end":"1963-11-22","startYear":1961,"endYear":1963,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Handled the Cuban Missile Crisis (October 1962); assassinated in Dallas."}},{"id":"pres-l-johnson","kind":"ruler","name":{"bg":"","en":"Lyndon B. Johnson"},"aliases":["L. B. Johnson","LBJ","Lyndon Johnson","Линдън Джонсън","Ел Би Джей"],"role":"president","start":"1963-11-22","end":"1969-01-19","startYear":1963,"endYear":1969,"precision":"exact","style":"new","tier":2,"parent":null,"category":null,"tags":[],"color":null,"blurb":{"bg":"","en":"Passed the Civil Rights Act (1964), the Voting Rights Act (1965) and Medicare, and escalated the Vietnam War. Won his own term in 1964."}},{"id":"pres-nixon","kind":"ruler","name":{"bg":"","en":"Richard Nixon"},"aliases":["Nixon","R. Nixon","Никсън","Ричард Никсън"],"role":"president","start":"1969-01-20","end":"1974-08-09","startYear":1969,"endYear":1974,"precision":"exact","style":"new","tier":2,"parent":null,"category":nu