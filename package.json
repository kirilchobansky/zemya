{
  "name": "zemya",
  "version": "0.1.0",
  "description": "An interactive atlas built for learning geography",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:content && react-router build",
    "build:content": "node scripts/build-content.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node test/smoke.mjs",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilchobansky/zemya.git"
  },
  "bugs": {
    "url": "https://github.com/kirilchobansky/zemya/issues"
  },
  "homepage": "https://github.com/kirilchobansky/zemya#readme",
  "dependencies": {
    "dexie": "4.4.6",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "country-json": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "svg-country-flags": "^1.2.10",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
