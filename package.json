{
  "name": "zemya",
  "version": "0.1.0",
  "description": "An interactive atlas built for learning geography",
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run build:content && react-router build",
    "build:content": "node scripts/build/build-content.mjs && node scripts/build/build-history.mjs && node scripts/build/build-tiles.mjs",
    "build:tiles": "node scripts/build/build-tiles.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node scripts/check-structure.mjs && node tests/e2e/smoke.mjs",
    "audit": "node scripts/audit/audit-freshness.mjs",
    "audit:flags": "node scripts/audit/audit-flags.mjs",
    "check:history": "node scripts/audit/check-history.mjs",
    "check:seo": "node scripts/audit/check-seo.mjs",
    "test:unit": "vitest run",
    "perf": "node tests/e2e/perf.mjs",
    "check": "node scripts/check-structure.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirilchobansky/zemya.git"
  },
  "bugs": {
    "url": "https://github.com/kirilchobansky/zemya/issues"
  },
  "homepage": "https://github.com/kirilchobansky/zemya#readme",
  "dependencies": {
    "@mapbox/tiny-sdf": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dexie": "4.4.6",
    "isbot": "^5",
    "maplibre-gl": "^6.12.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@react-router/dev": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "all-the-cities": "^3.1.0",
    "countries-list": "^3.4.1",
    "country-json": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "geojson-vt": "^5.0.4",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "svg-country-flags": "^1.2.10",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "vt-pbf": "^3.1.3",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
